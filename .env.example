# Copy this file to .env.local and fill in real values. .env.local is never committed.

# MongoDB connection string (include the database name in the path), e.g.:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/manpower?retryWrites=true&w=majority
MONGODB_URI=

# Password required to sign in to /admin
ADMIN_PASSWORD=

# Random long string used to sign admin session cookies. Generate one with:
# openssl rand -hex 32
ADMIN_SESSION_SECRET=
